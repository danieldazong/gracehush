{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": ["./src/*"],
      "@/assets/*": ["./assets/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", "nativewind-env.d.ts"],
  // supabase/functions is Deno code (npm: imports, .ts extensions, the Deno global): `deno check` checks it, not tsc.
  "exclude": ["node_modules", "supabase/functions"]
}
