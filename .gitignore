# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# Supabase CLI state, and the Edge Functions' secrets (the committed .env.example holds names only)
supabase/.temp/
supabase/.branches/
supabase/functions/.env
supabase/functions/.env.*
!supabase/functions/.env.example
deno.lock

# Step 22: the voice audition's MP3 files, and a Google service account's key file if one ever lands in the project folder
# (it belongs outside the repo: see prompts/22-tts-and-storage.md, step C)
tts-audition/
# Step 32: the tone evaluation's outputs (made-up entries, the reflections, the grades, three WAV files and the review sheet)
tone-eval/
# Step 38: Scholar's evaluation outputs (the made-up conversations' answers, their judgments and the readers' review pack)
scholar-eval/
*-service-account*.json
gracehush-tts*.json

# typescript
*.tsbuildinfo

example

# generated native folders
/ios
/android

# Local agent tooling: links to .agents/skills. EAS copies the working tree for a build, and on Windows it cannot recreate symlinks.
.claude/skills/
.commandcode/

# The website built from docs/ (gracehush.com, docs/site/build.cjs), and the company's name and address it is built with: both are published on the
# pages and stay out of the public repository. The facts file is not inside site/, so uploading site/ publishes nothing but the pages.
/site/
/docs/site/facts.json
