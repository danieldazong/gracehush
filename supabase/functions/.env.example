# The Edge Function secrets (step 19). Copy this file to supabase/functions/.env.local (git ignores it), fill it in,
# and never put a real value in this committed file.
#
# SUPABASE_URL and the project's secret key are provided by the platform: do not set them here (a name that starts with
# SUPABASE_ is rejected when secrets are set).

# From Google AI Studio (aistudio.google.com/apikey). A key on the free tier may only ever see made-up test text:
# Google may read and train on what a free key receives. Real people's prayers need a key from a project with billing.
# A key made in AI Studio since 2026-05-28 starts with AQ. (an "auth key", not AIza) and is sent in the same
# x-goog-api-key header: checked against the real API on 2026-10-23.
# This project's key has been on the paid tier since 2026-10-23 (Tier 1, $20 of Prepay credits): AGENTS.md, "Gemini
# connection and credit", says how it is connected, what it costs and what HTTP 402 means.
GEMINI_API_KEY=

# A current Flash-class model from ai.google.dev/gemini-api/docs/models. There is no default in the code on purpose.
# Step 19, real calls on 2026-10-23 with a free-tier key: gemini-3.8-flash took 30 to 90 s even for one word (queued
# under demand) and gemini-3.5-flash answered with 503s; gemini-3.1-flash-lite answered in 1 to 4 s, so it is the value
# in use. Time any model again before choosing it for real (step 32), and again with the billed key (step 25).
GEMINI_MODEL=

# Optional (step 21). A separate model for the crisis screening call, which runs before every reflection and reads the
# person's words or recording first. When this is empty the screening uses GEMINI_MODEL, which is the usual choice.
# Changing it (or screenPrompt.ts, or phrases.ts) means running the evaluation again, and every crisis case in it must
# still come back as a crisis: supabase/functions/_shared/safety/eval/run_eval.ts.
GEMINI_SCREENING_MODEL=

# Optional. A second model that every second attempt goes to, for the crisis screening and for the reflection, when the
# first model is busy: under heavy demand one model answers 503 "high demand" while another answers (seen on the free
# tier on 2026-10-23). It screens entries too, so it must pass the same evaluation as the screening model, run with
# GEMINI_SCREENING_MODEL set to it: supabase/functions/_shared/safety/eval/run_eval.ts. Empty: no second model.
GEMINI_FALLBACK_MODEL=

# low, medium or high. Optional: the function uses "low" when this is empty.
GEMINI_THINKING_LEVEL=

# Step 22, the spoken devotional (Google Cloud Text-to-Speech). Optional: with neither GOOGLE_TTS_CREDENTIALS_B64 nor
# TTS_VOICE_NAME set, a reflection is still made and saved as text and speech is simply off; set both and it turns on at once,
# with no new deploy. Text-to-Speech does NOT accept API keys (checked on 2026-10-23): it needs a service account.
#
# The service account's JSON key file as ONE line of base64 (prompts/22-tts-and-storage.md, step D, has the commands). It is a
# secret that can spend money: never commit it, never paste it into a chat, and keep the downloaded .json file outside this
# folder, deleted once this line is saved.
GOOGLE_TTS_CREDENTIALS_B64=

# A Chirp 3 HD voice, en-US-Chirp3-HD-<Name>, chosen by listening to supabase/functions/_shared/tts/audition.ts. No voice name
# is written in code.
TTS_VOICE_NAME=

# Optional, 0.25 to 2.0 (the audition chooses it). Empty: 0.92.
TTS_SPEAKING_RATE=

# The Clerk Frontend API URL of the instance the app signs in with: https://<name>.clerk.accounts.dev, no trailing slash.
# It is the `iss` of the session token, and it serves /.well-known/jwks.json.
CLERK_ISSUER=

# Optional, comma separated. When set, a token that carries an `azp` claim must name one of these.
CLERK_AUTHORIZED_PARTIES=

# Billing (step 30). RevenueCat is the source of truth for a person's plan: sync-subscription, revenuecat-webhook and
# process-entry's expiry guard re-read the customer with this key and write users_profile.subscription_tier themselves.
# A V1 SECRET key (sk_...) from RevenueCat: Project settings, API keys. It can read and change customers' purchases: never in
# the app, never in an EXPO_PUBLIC_ variable, never committed or pasted into a chat.
REVENUECAT_SECRET_API_KEY=

# The webhook's two checks, both required. REVENUECAT_WEBHOOK_AUTH is a random value you make (prompts/30-revenuecat.md, D)
# and paste into RevenueCat's "Authorization header value"; REVENUECAT_WEBHOOK_SIGNING_SECRET is the HMAC signing secret
# RevenueCat shows once when signing is turned on. Change either here and in RevenueCat together.
REVENUECAT_WEBHOOK_AUTH=
REVENUECAT_WEBHOOK_SIGNING_SECRET=

# Account deletion (step 31). delete-account deletes the person's Clerk user with this key, after it has deleted their files,
# rows and RevenueCat customer. The SECRET key of the Clerk instance the app signs in with (sk_test_... for the Development
# instance): Clerk dashboard, the app, Configure, API keys, Secret keys. It can delete any user of the instance: never in the
# app, never in an EXPO_PUBLIC_ variable, never committed or pasted into a chat.
CLERK_SECRET_KEY=

# Sign in with Apple at account deletion (step 35). delete-account ends Gracehush's access to the person's Sign in with Apple with
# these. All three empty: it is simply off, and the deletion still goes ahead. The Team ID (10 characters, Apple Developer,
# Membership details), the key's id (10 characters) and the key itself: a "Sign in with Apple" key's AuthKey_....p8 file as ONE line
# of base64. The key can act for the whole team's Sign in with Apple: never in the app, never in an EXPO_PUBLIC_ variable, never
# committed or pasted into a chat, and the downloaded file is deleted once this line is saved.
APPLE_TEAM_ID=
APPLE_SIWA_KEY_ID=
APPLE_SIWA_PRIVATE_KEY_B64=

# Scholar (step 38): scholar-turn and scholar-speak. Both read GEMINI_API_KEY and GEMINI_THINKING_LEVEL above, and scholar-speak
# reads the speech secrets above (the devotional's voice and rate).
# SCHOLAR_ENABLED: "true" turns Scholar on; anything else is off, and then no model is called (a heavy message still gets the
# written answer). It is read on every request: switching it needs no deploy. Production stays off (false) until the readers approve.
SCHOLAR_ENABLED=
# SCHOLAR_SCREEN_FIRST: "true" writes a typed message's answer only after its screening (slower, never a wasted answer); "false"
# writes it at the same time and holds it until the screening says clear. Put false
# in the local file rather than leave it empty.
SCHOLAR_SCREEN_FIRST=
# The three models, each a Gemini model name; none is written in code. SCHOLAR_MODEL writes everyday answers,
# SCHOLAR_SCREENING_MODEL screens every message, and SCHOLAR_HEAVY_MODEL writes every answer to a heavy moment and takes the
# second attempt of the other two. A missing or malformed one while Scholar is on is a 500 logged as bad_config:<NAME>.
SCHOLAR_MODEL=
SCHOLAR_SCREENING_MODEL=
SCHOLAR_HEAVY_MODEL=
# The project-wide ceiling on free messages answered in one UTC day (3000 when not a whole number above 0). Above it a free
# account's clear message gets the resting line; paying accounts and heavy conversations are never affected. `secrets set
# --env-file` sends every line, so no line may be empty: 3000 in the local file.
SCHOLAR_FREE_DAILY_BUDGET=

# Live voice (step 39): scholar-voice-start and scholar-voice-llm, and the agent setup script (_shared/voice/agent_setup.ts).
# ELEVENLABS_API_KEY: the ElevenLabs key restricted to ElevenAgents (write), Voices (read) and Text to Speech. It can start
# talks and spend the plan's minutes: never in the app, never in an EXPO_PUBLIC_ variable, never committed or pasted into a chat.
ELEVENLABS_API_KEY=
# The agent and the workspace secret the setup script made (it writes both here itself).
ELEVENLABS_AGENT_ID=
ELEVENLABS_LLM_SECRET_ID=
# ELEVENLABS_LLM_SECRET: the key ElevenLabs sends to scholar-voice-llm (stored in ElevenLabs as the agent's custom LLM key).
# SCHOLAR_VOICE_SESSION_SECRET: signs who a talk belongs to (_shared/voice/session.ts). Each is 64 random hex characters.
ELEVENLABS_LLM_SECRET=
SCHOLAR_VOICE_SESSION_SECRET=
