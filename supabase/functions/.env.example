# The Edge Function secrets (step 19). Copy this file to supabase/functions/.env.local (git ignores it), fill it in,
# and never put a real value in this committed file.
#
# SUPABASE_URL and the project's secret key are provided by the platform: do not set them here (a name that starts with
# SUPABASE_ is rejected when secrets are set).

# From Google AI Studio (aistudio.google.com/apikey). A key on the free tier may only ever see made-up test text:
# Google may read and train on what a free key receives. Real people's prayers need a key from a project with billing.
# A key made in AI Studio since 2026-05-28 starts with AQ. (an "auth key", not AIza) and is sent in the same
# x-goog-api-key header: checked against the real API on 2026-10-23.
GEMINI_API_KEY=

# A current Flash-class model from ai.google.dev/gemini-api/docs/models. There is no default in the code on purpose.
# Step 19, real calls on 2026-10-23 with a free-tier key: gemini-3.8-flash took 30 to 90 s even for one word (queued
# under demand) and gemini-3.5-flash answered with 503s; gemini-3.1-flash-lite answered in 1 to 4 s, so it is the value
# in use. Time any model again before choosing it for real (step 32), and again with the billed key (step 25).
GEMINI_MODEL=

# low, medium or high. Optional: the function uses "low" when this is empty.
GEMINI_THINKING_LEVEL=

# The Clerk Frontend API URL of the instance the app signs in with: https://<name>.clerk.accounts.dev, no trailing slash.
# It is the `iss` of the session token, and it serves /.well-known/jwks.json.
CLERK_ISSUER=

# Optional, comma separated. When set, a token that carries an `azp` claim must name one of these.
CLERK_AUTHORIZED_PARTIES=
